# Copy this file to .env.local and fill in the values

# Neon Database - Get from https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret
AUTH_SECRET=your-random-secret

# Google OAuth - Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Resend (email) - Get from https://resend.com
RESEND_API_KEY=re_xxx

# Cron secret - Any random string to protect cron endpoints
CRON_SECRET=your-random-cron-secret

# Auth whitelist - Only this email can login (server-side only, NOT NEXT_PUBLIC_)
ALLOWED_EMAIL=your-email@gmail.com
